page {
  background: #f4f6f8;
  color: #17202b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after { border: 0; }

.page-shell { padding: 28rpx 30rpx 44rpx; }
.eyebrow { color: #d95f59; font-size: 23rpx; letter-spacing: 2rpx; font-weight: 700; }
.page-title { font-size: 52rpx; line-height: 1.12; font-weight: 800; margin: 10rpx 0 14rpx; }
.muted { color: #7d8792; font-size: 25rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 38rpx 0 20rpx; }
.section-title { font-size: 32rpx; font-weight: 750; }
.section-action { color: #c74e4a; font-size: 24rpx; }
.panel { background: #ffffff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 10rpx 32rpx rgba(20, 30, 40, .05); }
.poster { width: 100%; height: 300rpx; border-radius: 12rpx; background: #d9dee4; object-fit: cover; }
.poster.small { height: 220rpx; }
.poster.tall { height: 420rpx; }
.pill { display: inline-flex; padding: 7rpx 14rpx; border-radius: 999rpx; background: #f2e5df; color: #ac4a43; font-size: 22rpx; }
.primary-btn { background: #d95f59; color: #fff; border-radius: 12rpx; font-size: 28rpx; font-weight: 700; }
.secondary-btn { background: #f5e9e6; color: #b14f49; border-radius: 12rpx; font-size: 28rpx; font-weight: 700; }
.empty { text-align: center; padding: 72rpx 30rpx; color: #89939d; }
.empty-title { font-size: 32rpx; color: #35404b; font-weight: 700; margin-bottom: 12rpx; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.movie-card { min-width: 0; }
.movie-name { font-size: 28rpx; font-weight: 700; margin-top: 14rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.movie-meta { color: #84909a; font-size: 22rpx; margin-top: 7rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.watch-count { color: #c74e4a; font-size: 22rpx; margin-top: 10rpx; }
