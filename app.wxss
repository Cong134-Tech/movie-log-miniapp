page { background: #09090b; color: #f5f3ef; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 28rpx; }
view, button, input, textarea { box-sizing: border-box; }
button { font-weight: 500; min-width: 0; }
button::after { border: 0; }
button[disabled] { background: #242429 !important; color: #777780 !important; }
.page-shell { padding: 40rpx 32rpx 56rpx; min-height: 100vh; }
.page-enter { animation: focus-in 480ms ease-out both; }
@keyframes focus-in {
  from { opacity: .25; filter: blur(9px); transform: translateY(12rpx); }
  to { opacity: 1; filter: blur(0); transform: translateY(0); }
}
.eyebrow { color: #ff5b62; font-size: 20rpx; letter-spacing: 4rpx; font-weight: 600; }
.page-title { font-size: 66rpx; line-height: 1.2; letter-spacing: -2rpx; font-weight: 700; margin: 22rpx 0 18rpx; }
.muted { color: #8d8c96; font-size: 25rpx; line-height: 1.65; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 42rpx 0 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.section-action { color: #86858f; font-size: 22rpx; }
.panel { background: linear-gradient(145deg, #19191e, #121215); border: 1rpx solid #29292f; border-radius: 28rpx; padding: 28rpx; box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, .24); }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.movie-card { min-width: 0; padding: 12rpx 12rpx 20rpx; background: #151518; border: 1rpx solid #28282e; border-radius: 26rpx; box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .26); transition: transform 180ms ease, border-color 180ms ease; }
.movie-card:active { transform: scale(.985); border-color: #615059; }
.poster-frame { position: relative; width: 100%; padding-top: 150%; overflow: hidden; border-radius: 18rpx; background: #202025; }
.poster { position: absolute; inset: 0; width: 100%; height: 100%; }
.poster-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; background: linear-gradient(transparent, rgba(0, 0, 0, .55)); pointer-events: none; }
.poster-year { position: absolute; left: 16rpx; bottom: 14rpx; color: #efedf0; font-size: 21rpx; letter-spacing: 2rpx; }
.poster-badge { position: absolute; top: 14rpx; right: 14rpx; padding: 7rpx 12rpx; border-radius: 10rpx; color: #fff; background: rgba(15, 15, 18, .82); border: 1rpx solid rgba(255, 255, 255, .14); font-size: 20rpx; }
.card-copy { padding: 4rpx 6rpx 0; }
.movie-name { font-size: 28rpx; font-weight: 600; margin-top: 18rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.movie-meta { color: #93919d; font-size: 21rpx; line-height: 1.5; margin-top: 9rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.watch-count { color: #ff6b72; font-size: 23rpx; margin-top: 18rpx; }
.pill { display: inline-flex; align-items: center; padding: 9rpx 16rpx; border-radius: 999rpx; background: #301b20; border: 1rpx solid #562a32; color: #ff777e; font-size: 22rpx; }
button.primary-btn { width: 100%; background: linear-gradient(115deg, #e82e43, #b91f3c); color: #fff; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; box-shadow: 0 10rpx 28rpx rgba(171, 27, 54, .2); }
.primary-btn:active { opacity: .85; }
.empty { text-align: center; padding: 52rpx 28rpx; color: #8d8c96; font-size: 25rpx; line-height: 1.7; }
.empty-icon { display: block; width: 64rpx; height: 64rpx; margin: 0 auto 24rpx; opacity: .75; }
.empty-title { font-size: 30rpx; color: #e7e4ea; font-weight: 500; margin-bottom: 12rpx; }
.empty-action { display: inline-block; color: #ff727b; font-size: 25rpx; margin-top: 22rpx; }
.footer-note { text-align: center; color: #605e6b; font-size: 19rpx; letter-spacing: 3rpx; margin-top: 42rpx; }
.chevron { color: #a2a0ab; font-size: 38rpx; line-height: 1; }
