<view class="page-shell detail-page {{revealing ? 'page-enter' : ''}}">
  <view class="eyebrow">FILM / {{movie.year || 'YOUR NEXT MEMORY'}}</view>
  <view class="detail-hero">
    <view class="hero-glow"></view>
    <view class="hero-poster-frame"><image class="hero-poster" mode="aspectFill" src="{{movie.poster || '/assets/poster-placeholder.png'}}" binderror="onPosterError" /><view wx:if="{{watchCount}}" class="hero-badge">已看 {{watchCount}} 次</view></view>
  </view>
  <view class="detail-title">{{movie.title}}</view>
  <view class="original-title">{{movie.originalTitle}}</view>
  <view class="detail-meta"><view class="meta-line">{{movie.year || '年份待补充'}}<text class="meta-divider">/</text>{{movie.countryLabel || '国家待补充'}}</view><view wx:if="{{watchCount}}" class="pill">{{watchCount}} 次观看</view></view>
  <view class="section-head"><view class="section-title">故事</view><view class="section-action">SYNOPSIS</view></view>
  <view class="panel overview">{{movie.overview || '暂无剧情简介'}}</view>
  <view class="panel credits-panel">
    <view class="credit-row"><view class="info-label">导演</view><view class="info-value">{{movie.director || (loading ? '正在获取资料…' : '暂无资料')}}</view></view>
    <view class="credit-row"><view class="info-label">主演</view><view class="info-value">{{movie.castLabel || (loading ? '正在获取资料…' : '暂无资料')}}</view></view>
  </view>
  <view class="section-head"><view class="section-title">记录这一场</view><view class="section-action">{{watchCount ? '第 ' + (watchCount + 1) + ' 次观看' : 'FIRST WATCH'}}</view></view>
  <view class="panel form-panel">
    <view class="field-label">观看日期</view>
    <picker mode="date" value="{{watchedAt}}" bindchange="onDateChange"><view class="date-picker"><view>{{watchedAt}}</view><image class="date-icon" src="/assets/icons/calendar.png" /></view></picker>
    <view class="field-label">观影感想 <text class="field-optional">/ 选填</text></view>
    <textarea value="{{note}}" placeholder="这一遍，你记住了什么？" placeholder-class="note-placeholder" bindinput="onNoteInput" maxlength="500" />
    <button class="primary-btn record-button" bindtap="markWatched">{{watchCount ? '记录第 ' + (watchCount + 1) + ' 次观看' : '记录这次观看'}}</button>
  </view>
  <view class="tmdb-credit" wx:if="{{movie.tmdbId}}">电影资料来自 TMDB<view>This product uses the TMDB API but is not endorsed or certified by TMDB.</view></view>
  <view class="footer-note">ONE FILM, MANY MEMORIES</view>
</view>
