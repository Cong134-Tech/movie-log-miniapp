.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 34rpx; }
.stat-card { background: #17202b; color: #fff; border-radius: 16rpx; padding: 28rpx; min-height: 150rpx; }
.stat-card.accent { background: #d95f59; }
.stat-number { font-size: 68rpx; font-weight: 800; line-height: 1; }
.stat-label { margin-top: 18rpx; font-size: 25rpx; opacity: .85; }
.export-btn { margin: 0; padding: 0 18rpx; line-height: 54rpx; height: 54rpx; font-size: 22rpx; color: #b14f49; background: #f5e9e6; border-radius: 9rpx; }
.export-gap { margin-left: 10rpx; }
.country-row, .latest-row { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eef0f2; font-size: 27rpx; }
.country-row:last-child, .latest-row:last-child { border-bottom: 0; }
.country-count { color: #c74e4a; font-weight: 700; }
.latest-name { font-size: 27rpx; font-weight: 700; }
