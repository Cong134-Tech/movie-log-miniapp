.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; margin-top: 36rpx; }
.stat-card { position: relative; overflow: hidden; background: linear-gradient(135deg, #24242b, #17171c); border: 1rpx solid #36343e; color: #f7f3f3; border-radius: 28rpx; padding: 28rpx; min-height: 260rpx; box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, .27); }
.stat-card.accent { background: linear-gradient(135deg, #e23c50, #99243d 95%); border-color: #d14c5d; }
.stat-index { position: relative; z-index: 1; font-size: 18rpx; letter-spacing: 2rpx; opacity: .65; }
.stat-number { position: relative; z-index: 1; font-size: 92rpx; font-weight: 600; letter-spacing: -4rpx; line-height: 1.1; margin-top: 20rpx; }
.stat-label { position: relative; z-index: 1; margin-top: 14rpx; font-size: 25rpx; opacity: .82; }
.stat-decoration { position: absolute; right: -90rpx; bottom: -80rpx; width: 240rpx; height: 240rpx; border: 1rpx solid rgba(255, 255, 255, .18); border-radius: 50%; box-shadow: 0 0 0 32rpx rgba(255, 255, 255, .04), 0 0 0 64rpx rgba(255, 255, 255, .025); }
.country-row { padding: 8rpx 0 26rpx; font-size: 26rpx; }
.country-line { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.country-count { color: #efb2bd; font-weight: 600; font-size: 28rpx; }
.country-count text { color: #8f8696; font-size: 21rpx; font-weight: 400; }
.country-track { height: 6rpx; border-radius: 999rpx; background: #2a252f; overflow: hidden; }
.country-fill { height: 100%; min-width: 6rpx; border-radius: 999rpx; background: linear-gradient(90deg, #b52c49, #f17782); transition: width 450ms ease; }
.country-note { border-top: 1rpx solid #302b34; padding-top: 18rpx; color: #746c7f; font-size: 20rpx; line-height: 1.6; }
.latest-list { padding: 6rpx 24rpx; }
.section-head-link { padding: 12rpx 14rpx; margin-left: -14rpx; margin-right: -14rpx; border-radius: 16rpx; transition: background-color 180ms ease; }
.section-head-link:active { background: #17151a; }
.recent-link { color: #ff7883; }
.latest-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid #2b2730; }
.latest-row:last-child { border-bottom: 0; }
.latest-poster { width: 72rpx; height: 108rpx; background: #252129; border-radius: 10rpx; flex-shrink: 0; }
.latest-copy { flex: 1; min-width: 0; }
.latest-name { font-size: 27rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.latest-index { color: #69606f; font-size: 26rpx; font-weight: 300; }
.settings-panel { padding: 0 24rpx; }
.settings-row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid #2b2730; }
.settings-row:last-child { border-bottom: 0; }
.settings-icon { width: 38rpx; height: 38rpx; opacity: .85; flex-shrink: 0; }
.settings-copy { flex: 1; min-width: 0; }
.settings-title { font-size: 27rpx; }
.settings-caption { color: #88808f; font-size: 21rpx; margin-top: 9rpx; line-height: 1.5; }
.about-name { color: #e7e1e8; font-size: 28rpx; font-weight: 500; }
.about-caption { color: #a39ba9; font-size: 22rpx; line-height: 1.7; margin-top: 12rpx; }
.data-credit { border-top: 1rpx solid #302b34; padding-top: 24rpx; margin-top: 24rpx; }
.tmdb-logo { display: block; width: 180rpx; height: 28rpx; }
.attribution { color: #9a91a0; font-size: 21rpx; line-height: 1.7; margin-top: 16rpx; }
.sheet-behind { filter: blur(7px) !important; transition: filter 200ms ease; }
.sheet-mask { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, .58); animation: mask-in 220ms ease both; }
.token-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 11; padding: 18rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border: 1rpx solid #443740; border-bottom: 0; border-radius: 36rpx 36rpx 0 0; background: #19171d; box-shadow: 0 -16rpx 80rpx rgba(0, 0, 0, .5); animation: sheet-in 320ms ease-out both; }
.sheet-handle { width: 64rpx; height: 6rpx; margin: 0 auto 24rpx; background: #51454f; border-radius: 99rpx; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
button.sheet-close { display: flex; align-items: center; justify-content: center; flex: 0 0 58rpx; min-width: 58rpx; padding: 0; margin: 0; width: 58rpx; height: 58rpx; line-height: 1; background: #2a252e; color: #c0b4c5; border-radius: 50%; font-size: 38rpx; font-weight: 300; }
.token-input { width: 100%; height: 180rpx; margin: 26rpx 0 18rpx; padding: 22rpx; border: 1rpx solid #46353f; border-radius: 20rpx; background: #0f0e12; color: #ebe1e9; font-size: 25rpx; line-height: 1.5; }
.token-placeholder { color: #766877; }
.sheet-note { color: #8e8191; font-size: 22rpx; line-height: 1.6; }
.token-error { color: #ff858e; font-size: 23rpx; margin-bottom: 14rpx; }
.token-save { height: 88rpx; line-height: 88rpx; margin-top: 28rpx; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { opacity: .4; transform: translateY(50rpx); filter: blur(8px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
