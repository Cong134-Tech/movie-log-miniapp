<view class="page-shell">
  <view class="eyebrow">PRIVATE MOVIE DIARY</view>
  <view class="page-title">今天想起哪部电影？</view>
  <view class="muted">找到它，记下这一场观看。</view>

  <view class="search-box">
    <input value="{{query}}" placeholder="搜索片名、导演或主演" confirm-type="search" bindinput="onInput" bindconfirm="search" />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view wx:if="{{usingDemo}}" class="demo-note">示例模式 · 配置 TMDB Token 后可搜索完整电影资料</view>
  <view class="section-head"><view class="section-title">电影结果</view><view class="section-action">{{results.length}} 部</view></view>
  <view wx:if="{{loading}}" class="panel loading">正在查找电影…</view>
  <view wx:elif="{{results.length}}" class="grid">
    <view class="movie-card" wx:for="{{results}}" wx:key="id" data-movie="{{item}}" bindtap="openDetail">
      <image class="poster small" mode="aspectFill" src="{{item.poster}}" />
      <view class="movie-name">{{item.title}}</view>
      <view class="movie-meta">{{item.year}} · {{item.countryLabel || '国家待补充'}}</view>
      <button class="mark-button" catchtap="markWatched" data-movie="{{item}}">{{item.watchCount ? '看过 ' + item.watchCount + ' 次' : '标记看过'}}</button>
    </view>
  </view>
  <view wx:else class="panel empty"><view class="empty-title">没有找到电影</view><view>换一个片名试试。</view></view>
</view>
