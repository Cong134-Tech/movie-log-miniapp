.title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-bottom: 38rpx; }
.title-row .page-title { margin-bottom: 14rpx; }
.wall-count { flex-shrink: 0; color: #ff6c77; font-size: 54rpx; font-weight: 600; line-height: 1; padding-bottom: 8rpx; }
.wall-count text { color: #a49aa7; font-size: 22rpx; font-weight: 400; margin-left: 4rpx; }
.wall-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 18rpx; row-gap: 34rpx; }
.wall-card { min-width: 0; padding: 10rpx 10rpx 16rpx; border: 1rpx solid #29272f; border-radius: 20rpx; background: linear-gradient(145deg, #1a191f, #111114); box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, .25); transition: transform 180ms ease, border-color 180ms ease; }
.wall-card:active { transform: scale(.975); border-color: #763441; }
.wall-poster-frame { position: relative; width: 100%; padding-top: 150%; overflow: hidden; border-radius: 13rpx; background: #242229; }
.wall-poster { position: absolute; inset: 0; width: 100%; height: 100%; }
.wall-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 34%; background: linear-gradient(transparent, rgba(0, 0, 0, .6)); pointer-events: none; }
.wall-year { position: absolute; left: 10rpx; bottom: 9rpx; color: #f0ecef; font-size: 17rpx; letter-spacing: 1rpx; }
.wall-watch-count { position: absolute; top: 9rpx; right: 9rpx; padding: 5rpx 8rpx; border-radius: 8rpx; color: #fff; background: rgba(12, 12, 15, .78); border: 1rpx solid rgba(255, 255, 255, .14); font-size: 17rpx; }
.wall-name { margin: 14rpx 3rpx 0; color: #f3eef1; font-size: 24rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wall-date { margin: 7rpx 3rpx 0; color: #847b89; font-size: 18rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.section-head-link { padding: 12rpx 14rpx; margin-left: -14rpx; margin-right: -14rpx; border-radius: 16rpx; transition: background-color 180ms ease; }
.section-head-link:active { background: #17151a; }
